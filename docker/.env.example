# Copy to .env in the repository root. No scheme or port in PUBLIC_HOST.
# All four variables are required and must be non-empty.
# Use the server's LAN/public IPv4 address or hostname for remote players.
PUBLIC_HOST=localhost
WEB_PORT=8080
# Published game-server port; the container still listens on 8001.
GAME_PORT=8001
POSTGRES_PASSWORD=survev

# Shared application config (also usable without Docker).
# Create this file before starting; an empty {} is sufficient.
# SURVEV_CONFIG=./survev-config.hjson
# Optional existing client integrations:
VITE_ENABLE_SURVEV_ADS=false
VITE_NITROPAY_SITE_ID=
VITE_BUILD_FOR_SPELLSYNC=false
# For docker/compose.tls.yaml:
# TLS_CERT_DIR=./data/certs
# WEB_TLS_PORT=443

# Include bundled PostgreSQL, migrations and Redis. Clear for external services.
COMPOSE_PROFILES=local
# REDIS_URL=redis://redis:6379
# Each Compose project needs its own data directory and published ports.
# DATA_DIR=./data
# Listen ports must match explicit apiServer.port / gameServer.port in HJSON.
# API_INTERNAL_PORT=8000
# GAME_INTERNAL_PORT=8001
# These set match defaults; also cover any explicit firstGamePort/maxGames.
# MATCH_PORT_START=9000
# MATCH_PORT_END=9063
# Web proxy target (also supports an API outside this Compose project).
# API_UPSTREAM=api:8000
# Development Vite ports (docker/compose.dev.yaml).
# DEV_PORT=3000
# DEV_INTERNAL_PORT=3000
# Optional build affinity limit on small Linux build machines.
# CLIENT_BUILD_CPUSET=0-2
