# Copy to .env in the repository root. No scheme or port in PUBLIC_HOST.
# All four variables are required and must be non-empty.
# Use the server's LAN/public IPv4 address or hostname for remote players.
PUBLIC_HOST=localhost
WEB_PORT=8080
# Published game-server port; the container still listens on 8001.
GAME_PORT=8001
POSTGRES_PASSWORD=survev
